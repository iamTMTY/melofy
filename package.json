{
  "name": "melofy",
  "version": "1.0.0",
  "private": true,
  "description": "Melofy monorepo — AI-translated, synced lyrics across web, a browser extension, and an eval harness.",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @melofy/web dev",
    "dev:eval": "pnpm --filter @melofy/eval dev",
    "dev:ext": "pnpm --filter @melofy/extension dev",
    "build": "turbo run build",
    "build:ext": "pnpm --filter @melofy/extension build",
    "build:ext:firefox": "pnpm --filter @melofy/extension build:firefox",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "docker:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d mongodb redis",
    "docker:down": "docker compose --env-file .env -f infra/docker-compose.yml down",
    "eval:dataset:sync": "pnpm --filter @melofy/eval dataset:sync",
    "eval:dataset:from-db": "pnpm --filter @melofy/eval dataset:from-db",
    "langfuse:up": "docker compose -f infra/langfuse/docker-compose.yml --env-file .env up -d",
    "langfuse:down": "docker compose -f infra/langfuse/docker-compose.yml --env-file .env down"
  },
  "devDependencies": {
    "turbo": "^2.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
