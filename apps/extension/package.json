{
  "name": "@melofy/extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Melofy Chrome extension — YouTube Music now-playing detection + in-page lyrics widget, and the now-playing bridge for the Melofy web app.",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "typecheck": "tsc --noEmit",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@melofy/core": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@wxt-dev/module-react": "^1.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "wxt": "^0.20.6"
  }
}
